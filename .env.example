# VaultRAG Configuration

# Application
APP_NAME=VaultRAG
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://vaultrag:vaultrag@localhost:5432/vaultrag

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=384

# LLM Configuration
MODE=offline  # 'cloud' or 'offline'

# Cloud LLM (Claude API) - Optional
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLOUD_MODEL=claude-sonnet-4-6

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OFFLINE_MODEL=mistral
ALTERNATIVE_MODEL=llama3.1:8b

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # 'cpu' or 'cuda'

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# Retrieval Parameters
BM25_TOP_K=50
VECTOR_TOP_K=50
RRF_K=60
RRF_TOP_N=30
RERANK_TOP_K=5
RERANK_MIN_SCORE=0.0

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# BM25 index persistence (avoid a bare relative path that depends on CWD)
BM25_INDEX_PATH=bm25_index.pkl

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3000

# Guardrails AI
GUARDRAILS_API_KEY=your_guardrails_api_key

# File Upload
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=.pdf,.docx

# Evaluation
RAGAS_FAITHFULNESS_THRESHOLD=0.80
RAGAS_RELEVANCY_THRESHOLD=0.75
